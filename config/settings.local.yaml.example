# Plantilla de config/settings.local.yaml — GITIGNORED (CLAUDE.md §10, §14).
#
# Cópiala a `settings.local.yaml` y rellénala. Se fusiona ENCIMA de settings.yaml, así
# que solo hace falta escribir lo que se quiera sobrescribir o añadir.
#
# Aquí van los datos personales: tesis, pesos objetivo y parámetros fiscales. Nunca se
# commitea y no se despliega.

universe:
  # Ficha de tesis obligatoria por empresa (§5.2). Objetivo: 15-30 empresas.
  # Es lista de ANÁLISIS, no de tenencia simultánea.
  #
  # Una ficha sin `invalidation` se rechaza al cargar la configuración. No es una
  # validación cosmética: sin criterio de falsación no hay forma de saber cuándo
  # vender, y la posición se sostiene sola por inercia.
  #
  # ⚠️ El CIK va SIEMPRE ENTRE COMILLAS. Sin ellas YAML lo lee como número, y un número
  # con ceros a la izquierda es OCTAL: el CIK de UBER, `0001543151`, se convierte en
  # 444009 — otro CIK perfectamente válido, de otra empresa, sin ningún error. De tus
  # ocho tickers, UBER y T eran vulnerables. La configuración ahora rechaza un CIK que no
  # sea texto, porque después de que YAML lo parsee ya no hay forma de detectarlo.
  tracked: []

  # --- En estudio (§5.1, cuarto círculo) --------------------------------------------
  #
  # Candidatos que estás leyendo. Ticker y CIK, nada más — y eso es el punto: una ficha
  # de tesis se escribe DESPUÉS de mirar los números, no antes. Un criterio de
  # invalidación inventado para poder guardar la ficha no protege de nada.
  #
  # Qué te da: el panel baja sus fundamentales auditados, presentaciones y calendario de
  # resultados, y la página de Empresa te los enseña enteros.
  # Qué NO hace: opinar. No entra al tablero de tesis ni cuenta como universo.
  #
  # Cuando termines la investigación, MUEVE la entrada a `tracked` y complétala. Estar en
  # los dos sitios a la vez se rechaza al cargar: o tiene tesis o no la tiene.
  watchlist: []
  #  - ticker: HIMS
  #    cik: "0001773751"          # entre comillas SIEMPRE: sin ellas YAML lo lee octal
  #  - ticker: AAPL
  #    cik: "0000320193"          # clave primaria real; el ticker es mutable (§9.3)
  #    sector: "Information Technology"
  #    thesis_category: "..."     # el eje que de verdad diversifica (§5.3)
  #    thesis: "Una frase: por qué esta empresa gana."
  #    value_accrual: "Cómo llega ese resultado al accionista."
  #    key_metric: "Concepto XBRL o derivado que hay que vigilar."
  #    invalidation: "Qué observación mata la tesis. Verificable, con umbral."
  #    review_date: 2027-01-15
  #    # OPCIONAL (§8 fase 2, punto 7): la versión que el panel evalúa solo. El texto de
  #    # `invalidation` sigue siendo obligatorio y sigue mandando; esto solo automatiza
  #    # lo que es mecánico. Una regla que nombre una métrica que el panel no calcula
  #    # reporta "no evaluable" — nunca pasa en silencio, que parecería salud.
  #    invalidation_rule: { metric: cash_conversion, operator: "<", threshold: 0.6 }
  #    # Reglas de salida (§2 nivel 4): se escriben ANTES de comprar. `trigger` y `action`
  #    # son texto y obligatorios; `rule` es opcional y es lo que la alerta evalúa sola.
  #    # Métricas de `rule`: las de invalidation_rule, más `price` (último cierre CRUDO:
  #    # un split posterior invalida el umbral), `weight` (peso en la cartera, 0-1) y
  #    # `return_pct` (valor / coste − 1). Cambiar el umbral re-arma la alerta.
  #    exit_ladder:
  #      - rule_id: AAPL-tp-1          # único en todo el archivo
  #        kind: take_profit           # take_profit | thesis_invalidation | rebalance
  #        trigger: "El peso pasa del 12 % de la cartera."
  #        action: "Vender hasta volver al 8 %."
  #        rule: { metric: weight, operator: ">", threshold: 0.12 }

# Cartera objetivo: pesos por posición y por thesis_category, para que el drift
# signifique algo (§13, entrada de usuario nº4). La cartera REAL nunca se escribe
# aquí: se lee del Flex Query de IBKR.
portfolio:
  target_weights: {}           # ej. { AAPL: 0.08, MSFT: 0.08 }
  target_by_thesis_category: {}

# Plan de aportes (§13, entrada de usuario nº1). Determina cuántas posiciones son
# razonables y si la comisión es material por ticket.
contributions:
  initial_amount_usd: null
  monthly_amount_usd: null
  currency: USD

# Diario de decisiones (📓 Diario). Una entrada por decisión; la operación la pone IBKR,
# aquí solo lo que únicamente tú sabes. Escríbela ANTES de ejecutar si puedes.
journal: []
#  - date: 2026-10-01
#    ticker: XXXX
#    why: "Por qué, en una o dos frases."
#    expectation: "Qué espero que pase, y en qué plazo."
#    premortem: "Si sale mal, habrá sido porque…"
#    review_after: 2027-04-01
#    review: ""          # al revisarla: ¿fue buena DECISIÓN con lo que sabía entonces?

# Coste de pasar pesos a IBKR (📋 Desplegar capital). Por cada depósito del extracto, los
# COP que costó: el extracto sabe los USD abonados, no los pesos pagados. Con 3+ depósitos
# de distinto tamaño el panel separa el coste fijo del proporcional; una tarifa conocida
# (fixed_fee_usd, proportional_cost = 0.01 para 1 %) manda sobre ese ajuste.
funding:
  deposits: []                            # ej. - {date: 2025-09-22, cop_paid: 500000, bought_on: 2025-09-19}
  fixed_fee_usd: null
  proportional_cost: null

# Comisiones IBKR (§13, entrada de usuario nº2). VERIFICAR en la cuenta, no asumir:
# la entidad contratante y el esquema (tiered/fixed) cambian el coste por operación.
broker:
  entity: null                 # ej. "IBKR Ireland" / "IBKR LLC" — verificar en la cuenta
  commission_scheme: null      # "tiered" | "fixed"
  fractional_shares: null      # true | false — verificar, no asumir

# Capa fiscal — LOCAL, todo ESTIMADO (§11).
# Claude no rellena tasas, umbrales ni tratamientos: son preguntas para el contador,
# listadas en RESEARCH.md. Mientras estén en null el panel muestra "no calculable".
fiscal:
  w8ben_on_file: null          # estado del W-8BEN en la cuenta (§13, entrada nº5)
  # Las retenciones sobre dividendos NO se configuran: se usa la retención OBSERVADA
  # que reporta el Flex Query en cash_transactions. Nunca una tasa supuesta.

  # Tasa de cambio oficial de TU moneda contra el USD (§9.9, §11). Vive solo aquí porque
  # la fuente y la moneda revelan tu jurisdicción. Sin este bloque la página Fiscal no
  # puede convertir nada y lo dice. Endpoint tipo Socrata: una fila por periodo de vigencia.
  local_fx:
    url: null                  # ej. https://www.datos.<pais>/resource/<id>.json
    currency: null             # ej. "XYZ": solo para rotular la página
    date_field: null           # campo con la fecha desde la que rige la tasa
    value_field: null          # campo con la tasa (moneda local por 1 USD)
    series_id: "FX:LOCAL_PER_USD"
    source: local_fx
    history_since: "2024-01-01"   # antes de tu primera operación

  # Periodo de tenencia que cambia el tratamiento de una ganancia, EN MESES. Pregúntalo a
  # tu contador; el panel no lo supone. En null, "no calculable" (§11).
  holding_period_months: null
