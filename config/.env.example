# Plantilla de config/.env — GITIGNORED. Cópiala a `config/.env` y rellénala.
# Ningún secreto entra al repo ni aparece en un log (CLAUDE.md §4.1, §10).

# --- FRED (macro, nivel 1) — clave gratuita en fred.stlouisfed.org --------------
FRED_API_KEY=

# --- SEC EDGAR (fundamentales, nivel 3) ----------------------------------------
# Obligatorio: la SEC bloquea las peticiones sin User-Agent identificable con nombre
# y correo reales (§4.4). Formato habitual: "Nombre Apellido correo@dominio.com".
# ENTRECOMÍLLALO: lleva espacios, y sin comillas el fichero deja de poder hacerse
# `source` desde bash (python-dotenv lo lee igual, pero cualquier script en shell falla).
SEC_USER_AGENT=

# --- IBKR Flex Web Service (cuenta real, SOLO LECTURA) -------------------------
# Este token es estructuralmente incapaz de colocar, modificar o cancelar órdenes, o
# de mover fondos: es una limitación del sistema de IBKR, no una configuración que
# haya que recordar mantener (§4.1). El proyecto nunca escribe en la cuenta.
#
# El token CADUCA y hay que regenerarlo; el fallo debe ser ruidoso y avisar por Telegram.
# Probar primero contra la cuenta PAPER, que tiene su propio token y query id.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# --- Telegram (alertas, fase 4) ------------------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime -------------------------------------------------------------------
# LOG_LEVEL=INFO
# PUBLIC_MODE=0        # 1 oculta la cuenta real y la capa fiscal
# DATABASE_URL=        # si se define, se usa PostgreSQL en vez de SQLite (fase 5)
